Package: HZIP
Type: Package
Title: Likelihood-Based Inference for Joint Modeling of Correlated
        Count and Binary Outcomes with Extra Variability and Zeros
Version: 0.1.1
Authors@R: c(person("Lizandra C.", "Fabio", email = "lizandra.fabio@ufba.br", role = "aut"),
  person("Jalmar M. F.", "Carrasco", email = "carrasco.jalmar@ufba.br", role = c("aut", "cre")),
